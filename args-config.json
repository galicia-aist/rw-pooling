{
  "model": {
    "type": "str",
    "choices": ["topk", "sag", "asap", "pan", "cop", "cgi", "kmis", "gsa", "ndp", "graclus", "hgpsl", "diff", "mincut", "dmon", "hosc", "justb"],
    "required": true,
    "help": "Pooling model to use"
  },
  "dataset": {
    "type": "str",
    "choices": ["MUTAG", "DD", "IMDB-MULTI", "PROTEINS", "COLLAB", "ppa", "molpcba", "molhiv"],
    "required": true,
    "help": "Dataset to use"
  },
  "epochs": {
    "type": "int",
    "default": 200,
    "help": "Number of epochs to train."
  },
  "lr": {
    "type": "float",
    "default": 0.001,
    "help": "Initial learning rate."
  },
  "weight_decay": {
    "type": "float",
    "default": 0.0005,
    "help": "Weight decay (L2 loss on parameters)."
  },
  "hidden": {
    "type": "int",
    "default": 16,
    "help": "Number of hidden units."
  },
  "dropout": {
    "type": "float",
    "default": 0.5,
    "help": "Dropout rate (1 - keep probability)."
  },
  "cuda": {
    "action": "store_true",
    "help": "Enable CUDA training (default: False)."
  },
  "ddp": {
    "action": "store_true",
    "default": false,
    "help": "Use Distributed Data Parallelism."
  },
  "seeds": {
    "type": "int",
    "nargs": "+",
    "default": [42, 43, 44],
    "help": "Random seed."
  },
  "max_nodes": {
    "type": "int",
    "default": 500,
    "help": "max nodes"
  },
  "log_level": {
    "type": "str",
    "choices": ["debug", "info", "warning", "error", "critical"],
    "default": "info",
    "help": "Logging level."
  },
  "log_path": {
    "type": "str",
    "default": "local",
    "help": "Path to store logs. Default is 'local'."
  },
  "exp_name": {
    "type": "str",
    "default": "exp",
    "help": "Custon name for this experiment"
  },
  "pratio": {
    "type": "float",
    "default": 0.9,
    "help": "pooling ratio"
  },
  "tolerance": {
    "type": "float",
    "default": 0.0001,
    "help": "early stop tolerance"
  },
  "early_stop": {
    "type": "int",
    "default": 150,
    "help": "early stop patience"
  },
  "batch_size": {
    "type": "int",
    "default": 512,
    "help": "early stop patience"
  }
}